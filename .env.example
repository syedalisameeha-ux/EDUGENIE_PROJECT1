# Get a Gemini API key from Google AI Studio. Keep the real key private.
GEMINI_API_KEY=put_your_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional local explanation model (requires requirements-local.txt and substantial disk/RAM).
# false uses Gemini for explanations; true loads LaMini-Flan-T5-783M locally.
EDU_USE_LOCAL_MODEL=false
LOCAL_MODEL_NAME=MBZUAI/LaMini-Flan-T5-783M
PORT=8000
